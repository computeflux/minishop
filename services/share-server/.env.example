# ── share-server 环境变量 ────────────────────────────────────────

# TEE 后端地址（读链数据走 contractDryRun 的 /gql 入口）
TEE_API_BASE=https://xiaobai.asyou.me:30118

# 公网域名（用于生成 canonical / og:image 的绝对 URL）
# 未设置则从请求头 x-forwarded-host / host 推导。CDN 部署后务必设为 CDN 域名。
SITE_URL=https://minishop.computeflux.ai

# gateway ABI 文件路径（Docker 默认 /app/data/gateway.json；dev 可指向 minishop/public/contract/gateway.json）
GATEWAY_ABI_PATH=/app/data/gateway.json

# 服务端口
PORT=3000
